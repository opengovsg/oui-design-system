{
  "name": "@oui/style-dictionary",
  "description": "Tool to generate tailwind variables from design tokens",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "pnpx token-transformer raw/tokens.json tokens/base.json global && tsx build.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "devDependencies": {
    "@oui/eslint-config": "workspace:*",
    "@oui/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "token-transformer": "^0.0.33",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  },
  "dependencies": {
    "flat": "^6.0.1",
    "lodash-es": "^4.17.21",
    "sd-tailwindcss-transformer": "^2.1.0",
    "style-dictionary": "^4.3.3",
    "tinycolor2": "^1.6.0"
  }
}

{
  "name": "@opengovsg/oui-theme",
  "version": "0.0.50",
  "sideEffects": false,
  "files": [
    "dist",
    "src/variants/*.css",
    "src/tailwind.css"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/opengovsg/oui-design-system",
  "repository": "https://github.com/opengovsg/oui-design-system",
  "main": "src/index.ts",
  "module": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "typings": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./base.css": "./src/variants/base.css",
      "./tailwind.css": "./src/tailwind.css"
    }
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./base.css": "./src/variants/base.css",
    "./tailwind.css": "./src/tailwind.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "devDependencies": {
    "@oui/eslint-config": "workspace:*",
    "@oui/prettier-config": "workspace:*",
    "@oui/typescript-config": "workspace:*",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:react",
    "tailwind-variants": "^3.1.1",
    "tailwindcss": "catalog:",
    "tsup": "^8.5.1",
    "typescript": "catalog:"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lodash-es": "^4.17.21",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-react-aria-components": "^2.0.0",
    "tw-animate-css": "^1.2.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "tailwind-variants": ">=3",
    "tailwindcss": ">=4"
  },
  "prettier": "@oui/prettier-config"
}

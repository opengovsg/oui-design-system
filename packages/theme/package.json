{
  "name": "@unnamed/theme",
  "version": "0.0.0",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "src/index.ts",
  "module": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "typings": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./tailwind.css": "./dist/index.css"
    }
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./tailwind.css": "./src/tailwind.css"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "devDependencies": {
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@unnamed/eslint-config": "workspace:*",
    "@unnamed/typescript-config": "workspace:*",
    "eslint": "^8.57.0",
    "tailwindcss": "4.0.0-beta.5",
    "tsup": "^8.0.2",
    "typescript": "5.5.4",
    "typescript-eslint": "8"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.0.0-beta.5",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "tailwind-merge": "^2.5.4",
    "tailwind-variants": "^0.3.0",
    "tailwindcss-react-aria-components": "^1.2.0"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.15"
  }
}

{
  "name": "@oui/theme",
  "version": "0.0.0",
  "sideEffects": false,
  "files": [
    "dist",
    "src/variants/*.css",
    "src/tailwind.css"
  ],
  "main": "src/index.ts",
  "module": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "typings": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./base.css": "./src/variants/base.css",
      "./tailwind.css": "./src/tailwind.css"
    }
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./base.css": "./src/variants/base.css",
    "./tailwind.css": "./src/tailwind.css"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@oui/eslint-config": "workspace:*",
    "@oui/prettier-config": "workspace:*",
    "@oui/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "inter-ui": "^4.1.0",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "tsup": "^8.0.2",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@tailwindcss/vite": "catalog:",
    "clsx": "^2.1.1",
    "react": "catalog:",
    "tailwind-merge": "^2.5.4",
    "tailwind-variants": "^0.3.0",
    "tailwindcss-react-aria-components": "^1.2.0"
  },
  "peerDependencies": {
    "inter-ui": ">=4.1.0",
    "tailwindcss": ">=catalog:"
  },
  "prettier": "@oui/prettier-config"
}

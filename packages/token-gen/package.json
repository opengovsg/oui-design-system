{
  "name": "@opengovsg/oui-token-gen",
  "version": "0.0.3",
  "description": "CLI tool to generate tailwind variables from design tokens",
  "keywords": [
    "cli",
    "design-tokens",
    "oui",
    "style-dictionary",
    "tailwind"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/opengovsg/oui-design-system.git",
    "directory": "tooling/token-gen"
  },
  "files": [
    "dist",
    "raw",
    "tokens"
  ],
  "type": "module",
  "publishConfig": {
    "bin": "./dist/cli.js",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "generate": "tsx src/generate.ts",
    "prebuild": "pnpm generate",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "@tokens-studio/sd-transforms": "^2.0.3",
    "commander": "^13.1.0",
    "flat": "^6.0.1",
    "lodash-es": "^4.18.1",
    "sd-tailwindcss-transformer": "^2.2.1",
    "style-dictionary": "^5.1.1"
  },
  "devDependencies": {
    "@oui/typescript-config": "workspace:*",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "catalog:"
  }
}

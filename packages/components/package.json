{
  "name": "@opengovsg/oui",
  "version": "0.0.4",
  "sideEffects": false,
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./*": {
      "source": "./src/*/index.ts",
      "import": {
        "types": "./dist/types/*/index.d.ts",
        "default": "./dist/esm/*/index.js"
      },
      "require": {
        "types": "./dist/types/*/index.d.ts",
        "default": "./dist/cjs/*/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsx ../../tooling/build-scripts/main.ts --dts --clean",
    "dev": "tsx ../../tooling/build-scripts/main.ts --watch",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "devDependencies": {
    "@opengovsg/oui-theme": "workspace:*",
    "@oui/chromatic": "workspace:*",
    "@oui/eslint-config": "workspace:*",
    "@oui/prettier-config": "workspace:*",
    "@oui/typescript-config": "workspace:*",
    "@storybook/react": "8.6.4",
    "@storybook/test": "8.6.4",
    "@types/prop-types": "^15.7.14",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.2",
    "prettier": "catalog:",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@internationalized/date": "^3.7.0",
    "@react-aria/calendar": "^3.7.0",
    "@react-aria/utils": "^3.27.0",
    "@react-stately/calendar": "^3.7.0",
    "fuzzysort": "^3.1.0",
    "nanoid": "^5.0.9",
    "react": "catalog:",
    "react-aria": "^3.37.0",
    "react-aria-components": "^1.6.0",
    "react-stately": "^3.35.0",
    "type-fest": "^4.34.1",
    "use-deep-compare": "^1.3.0"
  },
  "peerDependencies": {
    "@opengovsg/oui-theme": "workspace:*",
    "motion": ">=11.12.0 || >=12.0.0-alpha.1",
    "react-aria-components": "^1.6.0"
  },
  "prettier": "@oui/prettier-config"
}

{
  "name": "@opengovsg/oui",
  "version": "0.0.12",
  "sideEffects": false,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "files": [
    "dist"
  ],
  "repository": "https://github.com/opengovsg/oui-design-system",
  "homepage": "https://github.com/opengovsg/oui-design-system",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./*": {
      "source": "./src/*/index.ts",
      "import": {
        "types": "./dist/types/*/index.d.ts",
        "default": "./dist/esm/*/index.js"
      },
      "require": {
        "types": "./dist/types/*/index.d.ts",
        "default": "./dist/cjs/*/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsx ../../tooling/build-scripts/main.ts --dts --clean",
    "changeset": "cd ../.. && pnpm changeset",
    "dev": "tsx ../../tooling/build-scripts/main.ts --watch",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "devDependencies": {
    "@opengovsg/oui-theme": "workspace:*",
    "@oui/chromatic": "workspace:*",
    "@oui/eslint-config": "workspace:*",
    "@oui/prettier-config": "workspace:*",
    "@oui/typescript-config": "workspace:*",
    "@storybook/react-vite": "9.0.12",
    "@types/lodash-es": "^4.17.12",
    "@types/prop-types": "^15.7.15",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "csstype": "^3.1.3",
    "eslint": "catalog:",
    "lucide-react": "^0.475.0",
    "motion": "^12.18.1",
    "prettier": "catalog:",
    "storybook": "9.0.12",
    "tsx": "^4.20.3",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@internationalized/date": "^3.8.2",
    "@react-aria/calendar": "^3.8.3",
    "@react-aria/i18n": "^3.12.10",
    "@react-aria/utils": "^3.29.1",
    "@react-stately/calendar": "^3.8.2",
    "@react-stately/collections": "^3.12.5",
    "@react-stately/form": "^3.1.5",
    "@react-stately/list": "^3.12.3",
    "@react-stately/utils": "^3.10.7",
    "@react-types/shared": "^3.30.0",
    "@tanstack/react-virtual": "^3.13.10",
    "downshift": "^9.0.9",
    "fuzzysort": "^3.1.0",
    "lodash-es": "^4.17.21",
    "nanoid": "^5.1.5",
    "react": "catalog:",
    "react-aria": "^3.41.1",
    "react-aria-components": "^1.10.1",
    "react-stately": "^3.39.0",
    "type-fest": "^4.41.0",
    "use-deep-compare": "^1.3.0"
  },
  "prettier": "@oui/prettier-config",
  "peerDependencies": {
    "@opengovsg/oui-theme": "workspace:*",
    "motion": ">=11.12.0 || >=12.0.0-alpha.1",
    "react-aria-components": "^1.10.1"
  }
}

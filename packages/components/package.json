{
  "name": "@opengovsg/oui",
  "version": "0.0.61",
  "homepage": "https://github.com/opengovsg/oui-design-system",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": "https://github.com/opengovsg/oui-design-system",
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./*": {
      "source": "./src/*/index.ts",
      "import": {
        "types": "./dist/types/*/index.d.ts",
        "default": "./dist/esm/*/index.js"
      },
      "require": {
        "types": "./dist/types/*/index.d.ts",
        "default": "./dist/cjs/*/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsx ../../tooling/build-scripts/main.ts --dts --clean",
    "changeset": "cd ../.. && pnpm changeset",
    "dev": "tsx ../../tooling/build-scripts/main.ts --watch",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@internationalized/date": "catalog:react-aria",
    "@internationalized/string": "catalog:react-aria",
    "@react-aria/calendar": "catalog:react-aria",
    "@react-aria/focus": "catalog:react-aria",
    "@react-aria/i18n": "catalog:react-aria",
    "@react-aria/interactions": "catalog:react-aria",
    "@react-aria/utils": "catalog:react-aria",
    "@react-stately/calendar": "catalog:react-aria",
    "@react-stately/collections": "catalog:react-aria",
    "@react-stately/form": "catalog:react-aria",
    "@react-stately/list": "catalog:react-aria",
    "@react-stately/utils": "catalog:react-aria",
    "@react-types/shared": "catalog:react-aria",
    "@tanstack/react-virtual": "^3.14.10",
    "downshift": "^9.4.0",
    "fuzzysort": "^3.1.0",
    "lodash-es": "^4.18.1",
    "nanoid": "^6.0.1",
    "react-aria": "catalog:react-aria",
    "react-dropzone": "^19.1.1",
    "react-phone-number-input": "^3.4.14",
    "react-stately": "catalog:react-aria",
    "scroll-into-view-if-needed": "^3.1.0",
    "sonner": "^2.0.7",
    "type-fest": "^5.7.0",
    "use-deep-compare": "^1.3.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@opengovsg/oui-theme": "workspace:*",
    "@oui/chromatic": "workspace:*",
    "@oui/typescript-config": "workspace:*",
    "@storybook/react-vite": "catalog:storybook10",
    "@types/lodash-es": "^4.17.12",
    "@types/prop-types": "^15.7.15",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "csstype": "^3.2.3",
    "lucide-react": "^1.31.0",
    "motion": "^12.42.0",
    "react": "catalog:react",
    "react-aria-components": "catalog:react-aria",
    "storybook": "catalog:storybook10",
    "tsx": "^4.21.0",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@opengovsg/oui-theme": "workspace:*",
    "motion": ">=11.12.0 || >=12.0.0-alpha.1",
    "react": ">= 18",
    "react-aria-components": "^1.14.0"
  }
}

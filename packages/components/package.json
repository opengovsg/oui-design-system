{
  "name": "@opengovsg/oui",
  "version": "0.0.1",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build:types": "tsc --project tsconfig.build.json",
    "build": "rollup -c --configPlugin esbuild",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "devDependencies": {
    "@opengovsg/oui-theme": "workspace:*",
    "@oui/eslint-config": "workspace:*",
    "@oui/prettier-config": "workspace:*",
    "@oui/typescript-config": "workspace:*",
    "@rollup/plugin-replace": "^6.0.2",
    "@storybook/react": "8.5.4",
    "@types/node": "^22.13.1",
    "@types/prop-types": "^15.7.14",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.2",
    "prettier": "catalog:",
    "rollup": "^4.34.6",
    "rollup-plugin-delete": "^2.1.0",
    "rollup-plugin-esbuild": "^6.2.0",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "tinyglobby": "^0.2.10",
    "tsup": "^8.3.6",
    "type-fest": "^4.34.1",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@internationalized/date": "^3.7.0",
    "@react-aria/calendar": "^3.7.0",
    "@react-aria/utils": "^3.27.0",
    "@react-stately/calendar": "^3.7.0",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "nanoid": "^5.0.9",
    "react": "catalog:",
    "react-aria": "^3.37.0",
    "react-aria-components": "^1.6.0",
    "react-stately": "^3.35.0",
    "use-deep-compare": "^1.3.0"
  },
  "peerDependencies": {
    "@opengovsg/oui-theme": "workspace:*",
    "motion": ">=11.12.0 || >=12.0.0-alpha.1"
  },
  "prettier": "@oui/prettier-config"
}

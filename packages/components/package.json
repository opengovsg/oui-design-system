{
  "name": "@unnamed/components",
  "version": "0.0.0",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "publishConfig": {
    "registry": "http://localhost:4873"
  },
  "scripts": {
    "build": "tsup --dts",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "devDependencies": {
    "@storybook/react": "8.4.7",
    "@types/prop-types": "^15.7.14",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@unnamed/eslint-config": "workspace:*",
    "@unnamed/prettier-config": "workspace:*",
    "@unnamed/theme": "workspace:*",
    "@unnamed/typescript-config": "workspace:*",
    "eslint": "^8.57.0",
    "lucide-react": "^0.462.0",
    "motion": "^11.12.0",
    "prettier": "^3.3.3",
    "tsup": "^8.0.2",
    "type-fest": "^4.30.0",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "@internationalized/date": "^3.6.0",
    "@react-aria/calendar": "^3.6.0",
    "@react-aria/utils": "^3.26.0",
    "@react-stately/calendar": "^3.6.0",
    "nanoid": "^5.0.9",
    "react": "^18.2.0",
    "react-aria": "^3.36.0",
    "react-aria-components": "^1.4.1",
    "react-stately": "^3.34.0",
    "use-deep-compare": "^1.3.0"
  },
  "peerDependencies": {
    "@unnamed/theme": "workspace:*",
    "motion": ">=11.12.0 || >=12.0.0-alpha.1"
  },
  "prettier": "@unnamed/prettier-config"
}

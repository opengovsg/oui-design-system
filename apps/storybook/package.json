{
  "name": "@oui/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview-storybook": "serve storybook-static",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "clean": "rm -rf .turbo && rm -rf node_modules",
    "lint": "eslint .storybook --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "test-storybook",
    "test:vitest": "vitest --project=storybook"
  },
  "dependencies": {
    "@opengovsg/oui": "workspace:*",
    "@opengovsg/oui-theme": "workspace:*",
    "@oui/prettier-config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "inter-ui": "^4.1.0",
    "react": "catalog:",
    "react-aria-components": "^1.6.0",
    "react-dom": "catalog:",
    "storybook-dark-mode": "^4.0.2"
  },
  "devDependencies": {
    "@oui/eslint-config": "workspace:*",
    "@oui/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "^8.5.6",
    "@storybook/addon-actions": "^8.5.6",
    "@storybook/addon-essentials": "^8.5.6",
    "@storybook/addon-links": "^8.5.6",
    "@storybook/experimental-addon-test": "^8.5.6",
    "@storybook/react": "^8.5.6",
    "@storybook/react-vite": "^8.5.6",
    "@storybook/test": "^8.5.8",
    "@storybook/test-runner": "^0.21.1",
    "@storybook/theming": "^8.5.6",
    "@types/node": "^22.13.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^3.0.5",
    "@vitest/coverage-v8": "^3.0.5",
    "autoprefixer": "^10.4.20",
    "axe-playwright": "^2.1.0",
    "chromatic": "^11.25.2",
    "eslint": "catalog:",
    "playwright": "^1.50.1",
    "prettier": "catalog:",
    "serve": "^14.2.4",
    "storybook": "^8.5.6",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "6.1.0",
    "vitest": "^3.0.5"
  },
  "prettier": "@oui/prettier-config"

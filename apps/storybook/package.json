{
  "name": "@unnamed/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build --docs",
    "preview-storybook": "serve storybook-static",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "clean": "rm -rf .turbo && rm -rf node_modules",
    "lint": "eslint .storybook --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest --project=storybook"
  },
  "dependencies": {
    "@tailwindcss/vite": "catalog:",
    "@unnamed/components": "workspace:*",
    "@unnamed/prettier-config": "workspace:*",
    "@unnamed/theme": "workspace:*",
    "inter-ui": "^4.1.0",
    "react": "catalog:",
    "react-aria-components": "^1.4.1",
    "react-dom": "catalog:",
    "storybook-dark-mode": "^4.0.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.5.3",
    "@storybook/addon-actions": "8.5.3",
    "@storybook/addon-essentials": "8.5.3",
    "@storybook/addon-links": "8.5.3",
    "@storybook/experimental-addon-test": "8.5.3",
    "@storybook/react": "8.5.3",
    "@storybook/react-vite": "8.5.3",
    "@storybook/test-runner": "^0.21.0",
    "@storybook/theming": "8.5.3",
    "@types/node": "^22.10.1",
    "@unnamed/eslint-config": "workspace:*",
    "@unnamed/typescript-config": "workspace:*",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/browser": "^3.0.5",
    "@vitest/coverage-v8": "^3.0.5",
    "autoprefixer": "^10.4.20",
    "axe-playwright": "^2.1.0",
    "chromatic": "^11.25.2",
    "eslint": "catalog:",
    "playwright": "^1.50.1",
    "prettier": "catalog:",
    "serve": "^14.2.1",
    "storybook": "8.5.3",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "prettier": "@unnamed/prettier-config"
}

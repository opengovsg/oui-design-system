    "motion": "^12.18.1",
    "next": "16.2.6",
    "react": "catalog:react",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:react",
    "react-hook-form": "^7.75.0",
    "type-fest": "^4.41.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",

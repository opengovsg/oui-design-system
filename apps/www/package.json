  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.1",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@types/unist": "^3.0.3",
    "eslint": "catalog:",
    "eslint-config-next": "16.1.6",
    "postcss": "^8.5.2",
    "prettier": "catalog:",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.24.0",

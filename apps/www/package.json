    "@oui/eslint-config": "workspace:*",
    "@oui/prettier-config": "workspace:*",
    "@react-aria/i18n": "^3.12.13",
    "@shikijs/rehype": "^2.4.2",
    "@shikijs/transformers": "^2.4.2",
    "@tailwindcss/postcss": "^4.0.6",
    "fs-extra": "^11.3.0",
    "inter-ui": "^4.1.0",
    "jotai": "^2.12.1",
    "lru-cache": "^11.1.0",
    "lucide-react": "^0.475.0",
    "motion": "^12.18.1",
    "next": "16.1.6",
    "react": "catalog:react",
    "react-aria-components": "catalog:",

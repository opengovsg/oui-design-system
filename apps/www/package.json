    "@oui/eslint-config": "workspace:*",
    "@oui/prettier-config": "workspace:*",
    "@react-aria/i18n": "^3.12.13",
    "@tailwindcss/postcss": "^4.3.1",
    "fs-extra": "^11.3.0",
    "fumadocs-core": "^16.10.3",

{
  "name": "@oui/www",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "generate:themes": "tsx scripts/generate-themes.ts",
    "dev": "next dev",
    "generate:examples": "tsx scripts/generate-examples.ts && pnpm format:fix",
    "generate:registry": "tsx scripts/generate-shadcn-registry.ts",
    "verify:registry": "tsx scripts/registry/verify.ts",
    "build:registry": "tsx scripts/generate-shadcn-registry.ts",
    "build:next": "next build",
    "build": "pnpm run --sequential /^build:/",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "test": "pnpm test:registry",
    "test:registry": "vitest run --passWithNoTests scripts/registry",
    "test:registry:watch": "vitest scripts/registry"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
